FROM debian:bullseye

RUN printf '%s\n' \
        'deb http://deb.debian.org/debian bullseye main' \
        'deb http://archive.debian.org/debian-security bullseye-security main' \
        > /etc/apt/sources.list && \
    rm -f /etc/apt/sources.list.d/*
RUN dpkg --add-architecture arm64 && \
    dpkg --add-architecture armhf
RUN set -eux; \
    for attempt in 1 2 3; do \
        apt-get -o Acquire::Retries=3 -o Acquire::http::No-Cache=true \
            -o Acquire::Check-Valid-Until=false update && \
        apt-get -o Acquire::Retries=3 -y install \
            curl git build-essential gcc-multilib musl-tools musl-dev musl && \
        apt-get -o Acquire::Retries=3 -y install \
            crossbuild-essential-armhf crossbuild-essential-arm64 && \
        exit 0; \
        rm -rf /var/lib/apt/lists/*; \
        sleep $((attempt * 5)); \
    done; \
    exit 1

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain 1.97.1
ENV PATH="/root/.cargo/bin/:${PATH}"
RUN rustup target add aarch64-unknown-linux-gnu && \
    rustup target add arm-unknown-linux-gnueabihf

RUN mkdir /.cargo && \
    echo '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"' > /.cargo/config && \
    echo '[target.arm-unknown-linux-gnueabihf]\nlinker = "arm-linux-gnueabihf-gcc"' >> /.cargo/config

RUN mkdir /build
ENV CARGO_TARGET_DIR /build
ENV CARGO_HOME /build/cache

RUN mkdir /src

WORKDIR /src
CMD ["/src/docker/docker-build-arm.sh"]
